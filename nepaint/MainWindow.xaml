<Window x:Class="nepaint.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Графический редактор" Height="600" Width="900" MinHeight="400" MinWidth="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковая панель управления -->
        <Border Grid.Column="0" Background="#F0F0F0" Padding="10">
            <StackPanel>
                <TextBlock Text="Инструменты" FontWeight="Bold" Margin="0,0,0,5"/>
                <RadioButton x:Name="RbPencil" Content="Карандаш" IsChecked="True" Checked="Tool_Checked" Margin="0,0,0,5"/>
                <RadioButton x:Name="RbLine" Content="Линия" Checked="Tool_Checked" Margin="0,0,0,5"/>
                <RadioButton x:Name="RbRectangle" Content="Прямоугольник" Checked="Tool_Checked" Margin="0,0,0,5"/>
                <RadioButton x:Name="RbEllipse" Content="Эллипс" Checked="Tool_Checked" Margin="0,0,0,15"/>

                <TextBlock Text="Толщина линии" FontWeight="Bold" Margin="0,0,0,5"/>
                <Slider x:Name="SliderThickness" Minimum="1" Maximum="20" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderThickness_ValueChanged" Margin="0,0,0,15"/>
                <TextBlock Text="{Binding ElementName=SliderThickness, Path=Value, StringFormat='Текущая: {0} px'}" Margin="0,0,0,15"/>

                <TextBlock Text="Цвет" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="CbColor" SelectedIndex="0" SelectionChanged="CbColor_SelectionChanged" Margin="0,0,0,20">
                    <ComboBoxItem Content="Черный" Tag="Black"/>
                    <ComboBoxItem Content="Красный" Tag="Red"/>
                    <ComboBoxItem Content="Синий" Tag="Blue"/>
                    <ComboBoxItem Content="Зеленый" Tag="Green"/>
                    <ComboBoxItem Content="Желтый" Tag="Yellow"/>
                </ComboBox>

                <Button Content="Очистить холст" Click="BtnClear_Click" Padding="5" Margin="0,0,0,10"/>
                <Button Content="Сохранить" Click="BtnSave_Click" Padding="5"/>
            </StackPanel>
        </Border>

        <!-- Холст для рисования -->
        <Border Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="1" Margin="10" ClipToBounds="True">
            <Canvas x:Name="DrawingCanvas" Background="White"
                    MouseDown="DrawingCanvas_MouseDown"
                    MouseMove="DrawingCanvas_MouseMove"
                    MouseUp="DrawingCanvas_MouseUp"/>
        </Border>
    </Grid>
</Window>
